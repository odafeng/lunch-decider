# Optional: enable Places API (New) in a billing-enabled Google Cloud project.
# Server-only secret. Do not prefix this variable with VITE_.
GOOGLE_PLACES_API_KEY=
# Optional locally; set a shared random secret in every Vercel environment.
PHOTO_SIGNING_SECRET=
PORT=3001
# Optional override for your own Overpass instance.
OVERPASS_URL=https://overpass-api.de/api/interpreter
